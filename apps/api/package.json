{
  "name": "@afrimove/api",
  "version": "0.0.0",
  "private": true,
  "description": "API AfriMove : NestJS, PostgreSQL 16 (Prisma), authentification par rôle, journal d'audit.",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src prisma && eslint src",
    "test": "prisma generate && vitest run",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@afrimove/contrats": "workspace:*",
    "@afrimove/domain": "workspace:*",
    "@afrimove/sync": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "3.2.4"
  }
}
