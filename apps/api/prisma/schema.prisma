  latitude  Float
  longitude Float

  @@map("adresse_geolocalisee")
}

/**
 * ------------------------------------------------------------------ livraison moto (AM-148)
 */

/// Un livreur actif (ou suspendu), créé à l'activation de la demande ; le dossier devient le badge.
/// Le numéro MoMo n'y est que chiffré. SQL : badge et compte uniques, version pour la concurrence optimiste.
model Livreur {
  id                   String    @id @db.Uuid
  version              Int       @default(1)
  /// « L-BAF-0087 »
  badge                String    @unique
  numero               Int
  personneId           String    @unique @db.Uuid
  nom                  String
  ville                String
  /// SQL : moto | velo | pied | tricycle
  deplacement          String
  zone                 String
  heures               String
  chargeMax            String
  momoTelephoneChiffre String
  /// SQL : mtn | orange
  momoOperateur        String
  permisRef            String?
  assuranceRef         String?
  permisValideJusqua   DateTime? @db.Date
  assuranceExpireLe    DateTime? @db.Date
  moto                 String?
  disponible           Boolean
  actif                Boolean
  note                 Float
  creeA                DateTime  @db.Timestamptz(3)

  missions    MissionLivraison[]
  invitations InvitationLivreur[]

  @@index([actif, disponible, ville])
  @@map("livreur")
}

/// La demande d'un voyageur pour devenir livreur. SQL : une seule demande ouverte (recue) par personne.
model DemandeLivreur {
  dossier              String    @id
  version              Int       @default(1)
  personneId           String    @db.Uuid
  numero               Int
  ville                String
  deplacement          String
  zone                 String
  heures               String
  chargeMax            String
  momoTelephoneChiffre String
  momoOperateur        String
  permisRef            String?
  assuranceRef         String?
  deposeeA             DateTime  @db.Timestamptz(3)
  verifIdentiteA       DateTime? @db.Timestamptz(3)
  verifPiecesA         DateTime? @db.Timestamptz(3)
  permisValideJusqua   DateTime? @db.Date
  assuranceExpireLe    DateTime? @db.Date
  verifFormationA      DateTime? @db.Timestamptz(3)
  /// SQL : recue | activee | refusee
  etat                 String
  decision             Json?
  livreurId            String?   @db.Uuid

  @@index([personneId, deposeeA(sort: Desc)])
  @@map("demande_livreur")
}

/// Une mission de livraison d'un colis « moto ». SQL : une seule mission ouverte par colis (index unique partiel),
/// `UPDATE … WHERE id AND version` pour chaque changement.
model MissionLivraison {
  id            String    @id @db.Uuid
  version       Int       @default(1)
  colisId       String    @db.Uuid
  colisNumero   String
  /// SQL : en_attente | proposee | acceptee | livree | repli | sans_livreur | annulee
  etat          String
  livreurId     String?   @db.Uuid
  proposeeA     DateTime? @db.Timestamptz(3)
  expireA       DateTime? @db.Timestamptz(3)
  essais        Json
  tour          Int
  prochaineA    DateTime? @db.Timestamptz(3)
  creeA         DateTime  @db.Timestamptz(3)
  accepteeA     DateTime? @db.Timestamptz(3)
  livreeA       DateTime? @db.Timestamptz(3)
  trajet        Json
  distanceM     Int
  dureeMinutes  Int
  prixLivraison Int
  gain          Int
  absence       Json?
  repliA        DateTime? @db.Timestamptz(3)

  livreur Livreur? @relation(fields: [livreurId], references: [id], onDelete: Restrict)

  @@index([etat, expireA])
  @@index([livreurId, etat])
  @@index([colisId, creeA(sort: Desc)])
  @@map("mission_livraison")
}

/// Un lien de suivi partagé : seul le hachage du jeton est gardé.
model PartageSuivi {
  jetonHache String   @id
  colisId    String   @db.Uuid
  creeA      DateTime @db.Timestamptz(3)
  expireA    DateTime @db.Timestamptz(3)

  @@index([colisId])
  @@map("partage_suivi")
}

/// Une invitation envoyée par un livreur (limitée par jour).
model InvitationLivreur {
  id        BigInt   @id @default(autoincrement())
  livreurId String   @db.Uuid
  at        DateTime @db.Timestamptz(3)

  livreur Livreur @relation(fields: [livreurId], references: [id])

  @@index([livreurId, at])
  @@map("invitation_livreur")
}

/**
 * ------------------------------------------------------------------ vendeurs ambulants (AM-149)
 */

/// Un vendeur ambulant : `id` est le `personne.id` de son compte. Nom et téléphones n'y sont que chiffrés.
/// SQL : numéro unique, version pour la concurrence optimiste, clé étrangère vers `personne`.
model Vendeur {
  id                   String   @id @db.Uuid
  version              Int      @default(1)
  /// « V-0412 »
  numero               String   @unique
  nomChiffre           String
  telephoneChiffre     String
  quartier             String
  ville                String
  momoTelephoneChiffre String
  /// SQL : mtn | orange
  momoOperateur        String
  actif                Boolean
  creeA                DateTime @db.Timestamptz(3)

  agrements AgrementVendeur[]
  ventes    VenteVendeur[]
  credits   CreditCommissionVendeur[]
  debits    DebitCommissionVendeur[]

  @@map("vendeur")
}

/// L'agrément d'un vendeur par une agence : un agrément retiré est redonné par une mise à jour de la même ligne.
model AgrementVendeur {
  vendeurId           String    @db.Uuid
  compagnieId         String    @db.Uuid
  compagnieNom        String
  /// SQL : actif | retire
  etat                String
  commissionClassique Int
  commissionVip       Int
  accordeLe           DateTime  @db.Timestamptz(3)
  accordePar          String    @db.Uuid
  retireLe            DateTime? @db.Timestamptz(3)

  vendeur Vendeur @relation(fields: [vendeurId], references: [id], onDelete: Restrict)

  @@id([vendeurId, compagnieId])
  @@index([compagnieId])
  @@map("agrement_vendeur")
}

/// Une vente à un voisin. SQL : une seule vente en attente par vendeur, un même voisin n'a pas deux billets sur
/// un départ (index uniques partiels), billet unique.
model VenteVendeur {
  id                     String    @id @db.Uuid
  version                Int       @default(1)
  vendeurId              String    @db.Uuid
  compagnieId            String    @db.Uuid
  departId               String    @db.Uuid
  billetId               String    @unique @db.Uuid
  billetNumero           String?
  siege                  Int?
  voisinNomChiffre       String
  voisinTelephoneChiffre String
  voisinIndex            String
  empreinte              String
  origineCode            String
  origineVille           String
  destinationCode        String
  destinationVille       String
  /// SQL : classique | vip
  classe                 String
  departA                DateTime  @db.Timestamptz(3)
  prix                   Int
  commission             Int
  /// SQL : mtn_momo | orange_money
  moyen                  String
  /// SQL : en_attente | reglee | terminee | refusee | expiree | a_rembourser
  etat                   String
  creeA                  DateTime  @db.Timestamptz(3)
  expireA                DateTime  @db.Timestamptz(3)
  reference              String?
  regleeA                DateTime? @db.Timestamptz(3)
  cause                  String?
  termineeA              DateTime? @db.Timestamptz(3)
  majA                   DateTime  @db.Timestamptz(3)

  vendeur Vendeur                   @relation(fields: [vendeurId], references: [id], onDelete: Restrict)
  credits CreditCommissionVendeur[]

  @@index([vendeurId, creeA])
  @@index([etat, creeA])
  @@map("vente_vendeur")
}

/// Une commission gagnée : un crédit par vente (la clé est `commission:<venteId>`), jamais modifié.
model CreditCommissionVendeur {
  cle         String   @id
  vendeurId   String   @db.Uuid
  compagnieId String   @db.Uuid
  venteId     String   @db.Uuid
  montant     Int
  at          DateTime @db.Timestamptz(3)

  vendeur Vendeur      @relation(fields: [vendeurId], references: [id], onDelete: Restrict)
  vente   VenteVendeur @relation(fields: [venteId], references: [id], onDelete: Restrict)

  @@index([vendeurId, at])
  @@map("credit_commission_vendeur")
}

/// Un versement de commissions, réservé avant l'appel à l'opérateur. Le téléphone n'y est que chiffré.
model DebitCommissionVendeur {
  cle              String   @id
  vendeurId        String   @db.Uuid
  montant          Int
  at               DateTime @db.Timestamptz(3)
  /// SQL : en_attente | verse
  etat             String
  /// SQL : mtn | orange
  operateur        String
  telephoneChiffre String
  libelle          String
  reference        String?

  vendeur Vendeur @relation(fields: [vendeurId], references: [id], onDelete: Restrict)

  @@index([vendeurId])
  @@index([etat])
  @@map("debit_commission_vendeur")
}

/**
 * ------------------------------------------------------------------ financement, crédit et paie (AM-134)
 */

/// Un dossier d'avance sur recettes. AfriMove ne détient jamais les fonds : aucune colonne ne porte un solde.
/// SQL : une seule avance ouverte par agence (index unique partiel), référence du partenaire unique,
/// version pour la concurrence optimiste, mandat de prélèvement en colonnes.
model DossierFinancement {
  /// « AV-2027-0041 »
  id                     String    @id
  version                Int       @default(1)
  agenceId               String    @db.Uuid
  demandePar             String    @db.Uuid
  montant                Int
  /// SQL : envoye | en_analyse | verse | refuse | retire
  statut                 String
  partenaire             String?
  referencePartenaire    String?   @unique
  /// remboursementPctVentesMomo, dureeEstimeeSemaines, coutTotalPct
  conditions             Json
  envoyeA                DateTime  @db.Timestamptz(3)
  reponseAvant           DateTime  @db.Timestamptz(3)
  accuseA                DateTime? @db.Timestamptz(3)
  decisionA              DateTime? @db.Timestamptz(3)
  verseA                 DateTime? @db.Timestamptz(3)
  retireA                DateTime? @db.Timestamptz(3)
  motifRefus             String?
  /// Les quatre pièces figées à l'envoi.
  pieces                 Json
  mandatPourcentage      Int
  mandatSigneA           DateTime  @db.Timestamptz(3)
  mandatSignePar         String    @db.Uuid
  /// Référence du compte marchand, jamais le numéro.
  mandatCompteMarchandId String
  /// SQL : mtn | orange
  mandatOperateur        String
  mandatActif            Boolean
  resteDu                Int?
  rembourseA             DateTime? @db.Timestamptz(3)

  prelevements PrelevementAvance[]

  @@index([statut])
  @@index([agenceId, envoyeA(sort: Desc)])
  @@map("dossier_financement")
}

/// Un numéro d'avance par année : « AV-2027-0041 » est la valeur 41 de 2027.
model CompteurAvance {
  annee  Int @id
  valeur Int

  @@map("compteur_avance")
}

/// Un prélèvement sur une vente MoMo, versé directement au partenaire. La clé est `prelevement:<venteId>`.
model PrelevementAvance {
  cle          String   @id
  dossierId    String
  agenceId     String   @db.Uuid
  venteId      String   @unique
  montantVente Int
  montant      Int
  at           DateTime @db.Timestamptz(3)
  /// SQL : en_attente | execute
  etat         String
  reference    String?

  dossier DossierFinancement @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  @@index([dossierId])
  @@index([etat])
  @@map("prelevement_avance")
}

/// Un lot de paie par agence et par mois. SQL : unique (agenceId, mois).
model LotPaie {
  id       String   @id @db.Uuid
  version  Int      @default(1)
  agenceId String   @db.Uuid
  /// « AAAA-MM »
  mois     String
  lancePar String   @db.Uuid
  lanceA   DateTime @db.Timestamptz(3)
  total    Int

  lignes LignePaie[]

  @@unique([agenceId, mois])
  @@map("lot_paie")
}

/// Un salaire du lot. Le numéro MoMo n'y est que chiffré.
model LignePaie {
  lotId            String  @db.Uuid
  personneId       String  @db.Uuid
  /// Place dans le lot : l'ordre d'écriture est conservé.
  rang             Int
  nom              String
  montant          Int
  /// SQL : mtn | orange
  operateur        String?
  telephoneChiffre String?
  /// SQL : en_attente | verse | refuse
  etat             String
  tentative        Int
  reference        String?
  motif            String?

  lot LotPaie @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@id([lotId, personneId])
  @@index([etat])
  @@map("ligne_paie")
}

/// Réglages de l'agence propres au financement.
model ReglageFinancement {
  agenceId         String  @id @db.Uuid
  billetEnDeuxFois Boolean @default(false)
  jourDePaie       String  @default("vendredi")

  @@map("reglage_financement")
}

/// La convention avec l'établissement partenaire (écrite par un agent AfriMove, aucune route ici).
model ConventionFinancement {
  agenceId   String    @id @db.Uuid
  partenaire String
  signeeA    DateTime? @db.Timestamptz(3)

  @@map("convention_financement")
}

/// L'offre de crédit matériel faite par le partenaire (écrite par le partenaire ou un agent, aucune route ici).
model OffreCreditMateriel {
  agenceId          String @id @db.Uuid
  description       String
  montantTotal      Int
  mensualites       Int
  montantMensualite Int

  @@map("offre_credit_materiel")
}

/**
 * ------------------------------------------------------------------ inter-agences (AM-135)
 */

/// Une convention entre deux compagnies (A propose, B accepte). SQL : une seule convention ouverte par paire de
/// compagnies, quel que soit l'ordre (index unique partiel sur la paire triée), version pour la concurrence optimiste.
model ConventionInterAgences {
  id             String    @id @db.Uuid
  version        Int       @default(1)
  compagnieAId   String    @db.Uuid
  compagnieBId   String    @db.Uuid
  /// SQL : proposee | active | suspendue | resiliee
  statut         String
  /// SQL : trimestriel | annuel
  renouvellement String
  /// Le colis type et le tableau des parts.
  parts          Json
  /// Garantie, attente et lignes des billets en correspondance.
  voyageurs      Json
  proposeeLe     DateTime  @db.Timestamptz(3)
  activeLe       DateTime? @db.Timestamptz(3)
  /// Qui demande la sortie, quand, et quand elle prend effet.
  denonciation   Json?

  signatures SignatureConvention[]
  colis      PlanColisInterAgences[]
  billets    BilletCorrespondance[]
  reglements ReglementInterAgences[]

  @@index([compagnieAId])
  @@index([compagnieBId])
  @@map("convention_inter_agences")
}

/// La signature d'une compagnie : une par compagnie et par convention.
model SignatureConvention {
  conventionId String   @db.Uuid
  compagnieId  String   @db.Uuid
  personneId   String   @db.Uuid
  signeLe      DateTime @db.Timestamptz(3)
  /// Place dans la convention : l'ordre des signatures est conservé.
  rang         Int

  convention ConventionInterAgences @relation(fields: [conventionId], references: [id], onDelete: Restrict)

  @@id([conventionId, compagnieId])
  @@map("signature_convention")
}

/// Le plan d'un colis qui change de compagnie en route : un par colis. Les tronçons et les passages de témoin
/// sont figés en JSON ; `compagnieIds` (les compagnies des tronçons) sert à retrouver les échanges d'une compagnie.
model PlanColisInterAgences {
  colisId      String   @id @db.Uuid
  version      Int      @default(1)
  numero       String
  conventionId String   @db.Uuid
  emettriceId  String   @db.Uuid
  prix         Int
  troncons     Json
  compagnieIds String[] @db.Uuid
  transferts   Json
  creeLe       DateTime @db.Timestamptz(3)
  creePar      String   @db.Uuid

  convention ConventionInterAgences @relation(fields: [conventionId], references: [id], onDelete: Restrict)

  @@index([conventionId])
  @@map("colis_inter_agences")
}

/// Un billet voyageur en plusieurs tronçons, sous le numéro du billet vendu. Nom et téléphone du voyageur
/// ne sont écrits que chiffrés.
model BilletCorrespondance {
  /// Le billet vendu.
  id                       String   @id @db.Uuid
  version                  Int      @default(1)
  numero                   String   @unique
  conventionId             String   @db.Uuid
  emettriceId              String   @db.Uuid
  voyageurNomChiffre       String
  voyageurTelephoneChiffre String
  prix                     Int
  troncons                 Json
  compagnieIds             String[] @db.Uuid
  arriveePremierBus        Json?
  replacement              Json?
  creeLe                   DateTime @db.Timestamptz(3)
  creePar                  String   @db.Uuid

  convention ConventionInterAgences @relation(fields: [conventionId], references: [id], onDelete: Restrict)

  @@index([conventionId])
  @@map("billet_correspondance")
}

/// Un règlement arrêté : un par convention et par lundi (`<conventionId>:<AAMMJJ>`).
model ReglementInterAgences {
  cle          String    @id
  conventionId String    @db.Uuid
  paiementLe   DateTime  @db.Timestamptz(3)
  gelLe        DateTime  @db.Timestamptz(3)
  /// Les créances réglées, telles qu'arrêtées.
  lignes       Json
  /// Nuls quand le solde est nul.
  debiteurId   String?   @db.Uuid
  creancierId  String?   @db.Uuid
  montant      Int
  /// SQL : a_payer | paye | sans_solde
  etat         String
  reference    String?
  payeLe       DateTime? @db.Timestamptz(3)
  erreur       String?

  convention ConventionInterAgences @relation(fields: [conventionId], references: [id], onDelete: Restrict)
  creances   CreanceReglee[]

  @@index([conventionId, paiementLe])
  @@map("reglement_inter_agences")
}

/// Une opération réglée (`colis:<id>:<rang>`, `billet:<id>:<rang>`, `replacement:<id>`) : la clé primaire garantit
/// qu'elle ne l'est qu'une fois, dans un seul règlement. En ajout seul.
model CreanceReglee {
  cle          String @id
  reglementCle String

  reglement ReglementInterAgences @relation(fields: [reglementCle], references: [cle], onDelete: Restrict)

  @@index([reglementCle])
  @@map("creance_reglee")
}

/// Une contestation du relevé de la semaine.
model ContestationReglement {
  /// `CTX-AAMMJJ-n`
  reference     String    @id
  conventionIds String[]  @db.Uuid
  compagnieId   String    @db.Uuid
  personneId    String    @db.Uuid
  motif         String
  /// Les opérations contestées (`cle` des créances), figées au dépôt.
  cles          String[]
  deposeeLe     DateTime  @db.Timestamptz(3)
  recevable     Boolean
  /// SQL : ouverte | accordee | rejetee | irrecevable
  statut        String
  resolueLe     DateTime? @db.Timestamptz(3)
  resoluePar    String?   @db.Uuid

  @@index([statut])
  @@index([compagnieId])
  @@map("contestation_reglement")
}

/// Une invitation envoyée à une autre compagnie. SQL : `cle` unique (une par compagnie, numéro et jour).
model InvitationCompagnie {
  /// `INV-AAMMJJ-n`
  reference        String   @id
  /// `<compagnieId>:<téléphone>:<AAMMJJ>`
  cle              String   @unique
  compagnieId      String   @db.Uuid
  personneId       String   @db.Uuid
  nomCompagnie     String
  telephoneChiffre String
  envoyeeLe        DateTime @db.Timestamptz(3)

  @@map("invitation_compagnie")
}

/// Le compte mobile money d'une compagnie, qui paie et reçoit le solde net des règlements. Le numéro n'y est
/// que chiffré. Aucune route ne l'écrit encore.
model CompteMomoCompagnie {
  compagnieId      String @id @db.Uuid
  telephoneChiffre String
  /// SQL : mtn | orange
  operateur        String

  @@map("compte_momo_compagnie")
}

/**
 * ==================================================================================================
 * LOT Db · accueil du guichet, cadence et impressions (recette AM-181, anomalie A2). Migration
 * 20261018001001. Bloc contigu en fin de fichier pour faciliter la fusion avec les autres lots.
 * Aucune relation Prisma vers les tables des lots précédents : les clés étrangères sont posées en SQL.
 * ==================================================================================================
 */

/// Une impression demandée par l'appareil (`impression.demandee`) : un billet, une étiquette de colis ou un
/// ticket de caisse, en une ou plusieurs copies, première impression ou réimpression. L'identifiant de
/// l'événement (UUID créé sur l'appareil) est la clé : rejouer l'événement n'ajoute rien. EN AJOUT SEUL : le
/// journal sait combien de copies d'un document existent.
model ImpressionAgence {
  evenementId  String   @id @db.Uuid
  /// SQL : billet | etiquette_colis | ticket_caisse
  document     String
  /// Identifiant du billet, du colis ou de la session de caisse imprimé.
  documentId   String
  /// SQL : de 1 à 5
  copies       Int
  reimpression Boolean
  /// SQL : clé étrangère vers `personne`.
  auteurId     String   @db.Uuid
  appareilId   String
  /// SQL : clé étrangère vers `compagnie`.
  compagnieId  String?  @db.Uuid
  /// L'heure de l'événement, sur l'appareil.
  imprimeeA    DateTime @db.Timestamptz(3)
  /// L'heure à laquelle le serveur l'a reçu.
  recuA        DateTime @db.Timestamptz(3)

  @@index([document, documentId])
  @@index([auteurId, imprimeeA])
  @@map("impression_agence")
}
