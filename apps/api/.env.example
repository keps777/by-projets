# API AfriMove : configuration par variables d'environnement.
#
# Développement local :  cp .env.example .env   (le fichier .env n'est jamais versionné)
# Production / dev hébergé : ces variables viennent de l'hôte (secrets.env, voir infra/README.md).
#
# Les valeurs ci-dessous contiennent « dev-seulement » : elles servent à démarrer en local et
# l'API REFUSE de démarrer en production si l'une d'elles est restée telle quelle.
# Pour générer de vraies valeurs :
#   openssl rand -base64 48        -> JWT_SECRET, AUTH_PEPPER, AUDIT_HMAC_KEY
#   openssl rand -base64 32        -> ENCRYPTION_KEY, BLIND_INDEX_KEY

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Base PostgreSQL 16 (le mot de passe est celui de POSTGRES_PASSWORD dans docker-compose.yml)
DATABASE_URL=postgresql://afrimove:dev-seulement@localhost:5432/afrimove

# --- Où les modules métier rangent leurs données : postgres | memoire. Vide : PostgreSQL en
# production, mémoire sinon. Voir apps/api/INTEGRATION.md pour les modules déjà branchés sur la base.
# API_STOCKAGE=postgres

# --- Jetons d'accès (JWT HS256, 32 caractères minimum)
JWT_SECRET=dev-seulement-jwt-secret-0123456789abcdef
JWT_TTL_SECONDS=3600

# --- Poivre des PIN, mots de passe et codes SMS (32 caractères minimum)
AUTH_PEPPER=dev-seulement-pepper-0123456789abcdef

# --- Chiffrement au repos (AES-256-GCM) : clé de 32 octets en base64.
# Rotation : mettre la nouvelle clé dans ENCRYPTION_KEY (avec un nouvel ENCRYPTION_KEY_ID) et
# l'ancienne dans ENCRYPTION_PREVIOUS_KEYS au format « id:base64,id2:base64 ».
ENCRYPTION_KEY=ZGV2LXNldWxlbWVudC1jbGUtMzItb2N0ZXRzLTAwMDA=
ENCRYPTION_KEY_ID=k1
# ENCRYPTION_PREVIOUS_KEYS=

# --- Index aveugle des téléphones (HMAC, 32 octets en base64) : NE JAMAIS changer sans réindexer
BLIND_INDEX_KEY=ZGV2LXNldWxlbWVudC1jbGUtaW5kZXgtYXZldWdsZS0=

# --- Chaîne d'empreintes du journal d'audit (32 caractères minimum) : NE JAMAIS changer
AUDIT_HMAC_KEY=dev-seulement-audit-0123456789abcdef

# --- Codes SMS
OTP_TTL_SECONDS=300
OTP_MAX_ESSAIS=5
OTP_MAX_DEMANDES_15MIN=3
# Seul le simulateur existe pour l'instant.
SMS_DRIVER=mock
# true : le simulateur écrit les SMS (donc les codes) dans la console. Interdit en production.
SMS_MOCK_LOG_CODES=true

# --- Réseau
# Origines autorisées pour CORS, séparées par des virgules (vide : aucune)
CORS_ORIGINS=http://localhost:5173
# Derrière un proxy (Caddy, Nginx) : true ou nombre de proxys, pour lire la vraie adresse du client
TRUST_PROXY=false
# Documentation OpenAPI sur /docs et /openapi.json
OPENAPI_ENABLED=true
# Limitation de débit par adresse (120 requêtes par minute, 10 sur les routes de connexion)
RATE_LIMIT_ENABLED=true

# --- Seed de développement (pnpm --filter @afrimove/api run seed, après build et migrate) : secrets des comptes de démonstration.
# Absents, ils sont tirés au hasard et affichés une fois.
# SEED_PIN=
# SEED_MOT_DE_PASSE=
