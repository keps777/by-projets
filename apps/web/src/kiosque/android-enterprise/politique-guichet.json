{
  "applications": [
    {
      "packageName": "com.android.chrome",
      "installType": "KIOSK",
      "lockTaskAllowed": true,
      "defaultPermissionPolicy": "GRANT",
      "managedConfiguration": {
        "HomepageLocation": "https://app.afrimove.exemple.org/guichet/accueil?kiosque=1",
        "HomepageIsNewTabPage": false,
        "RestoreOnStartup": 4,
        "RestoreOnStartupURLs": ["https://app.afrimove.exemple.org/guichet/accueil?kiosque=1"],
        "URLBlocklist": ["*"],
        "URLAllowlist": ["https://app.afrimove.exemple.org", "https://api.afrimove.exemple.org"],
        "FullscreenAllowed": true,
        "IncognitoModeAvailability": 1,
        "DeveloperToolsAvailability": 2,
        "BookmarkBarEnabled": false,
        "EditBookmarksEnabled": false,
        "ShowHomeButton": false,
        "PasswordManagerEnabled": false,
        "AutofillAddressEnabled": false,
        "AutofillCreditCardEnabled": false,
        "BrowserSignin": 0,
        "SyncDisabled": true,
        "TranslateEnabled": false,
        "DefaultPopupsSetting": 2,
        "DownloadRestrictions": 3,
        "SafeBrowsingProtectionLevel": 1
      }
    }
  ],
  "kioskCustomLauncherEnabled": true,
  "kioskCustomization": {
    "powerButtonActions": "POWER_BUTTON_AVAILABLE",
    "systemErrorWarnings": "ERROR_AND_WARNINGS_MUTED",
    "systemNavigation": "NAVIGATION_DISABLED",
    "statusBar": "NOTIFICATIONS_AND_SYSTEM_INFO_DISABLED",
    "deviceSettings": "SETTINGS_ACCESS_BLOCKED"
  },
  "factoryResetDisabled": true,
  "safeBootDisabled": true,
  "addUserDisabled": true,
  "modifyAccountsDisabled": true,
  "installAppsDisabled": true,
  "uninstallAppsDisabled": true,
  "debuggingFeaturesAllowed": false,
  "usbFileTransferDisabled": true,
  "mountPhysicalMediaDisabled": true,
  "screenCaptureDisabled": true,
  "keyguardDisabled": true,
  "encryptionPolicy": "ENABLED_WITHOUT_PASSWORD",
  "advancedSecurityOverrides": {
    "untrustedAppsPolicy": "DISALLOW_INSTALL",
    "googlePlayProtectVerifyApps": "VERIFY_APPS_ENFORCED",
    "developerSettings": "DEVELOPER_SETTINGS_DISABLED"
  },
  "systemUpdate": { "type": "AUTOMATIC" },
  "statusReportingSettings": {
    "applicationReportsEnabled": true,
    "deviceSettingsEnabled": true,
    "softwareInfoEnabled": true,
    "memoryInfoEnabled": false,
    "networkInfoEnabled": false,
    "displayInfoEnabled": false,
    "powerManagementEventsEnabled": false,
    "hardwareStatusEnabled": false
  }
}
