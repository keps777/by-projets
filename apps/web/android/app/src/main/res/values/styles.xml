<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Thème de l'application : fond Nuit (jeton de design de packages/design), barres système transparentes.
        Capacitor l'applique (AppTheme.NoActionBar) dès que l'écran de lancement a rendu la main.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nuit</item>
        <item name="colorPrimaryDark">@color/nuit</item>
        <item name="colorAccent">@color/ambre</item>
        <item name="android:windowBackground">@color/nuit</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Écran de lancement : Android 12+ (API des écrans de lancement) et, avant, l'image drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nuit</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
