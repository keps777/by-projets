{
  "name": "@afrimove/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "src",
    "css",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src css vitest.config.ts",
    "test": "vitest run --passWithNoTests"
  }
}
