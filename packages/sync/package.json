{
  "name": "@afrimove/sync",
  "version": "0.0.0",
  "private": true,
  "description": "Moteur hors ligne et synchronisation des apps agence : file d'événements locale (Dexie), rejeu, indicateur SYNC / HORS LIGNE, blocage après 12 h.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@afrimove/contrats": "workspace:*",
    "@afrimove/domain": "workspace:*",
    "dexie": "4.4.6",
    "react": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
