  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error --output machine | grep -E 'ERROR|COMPLETED' | grep -v 'ERRORS 0 ' || true",
