    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
