# AM-172 · Sonde de fraîcheur des sauvegardes (voir afrimove-verification.timer).
[Unit]
Description=AfriMove · vérification de la fraîcheur des sauvegardes chez les deux fournisseurs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Environment=SAUVEGARDES_ENV=/etc/afrimove/sauvegardes.env
Environment=RCLONE_CONFIG=/etc/afrimove/rclone.conf
ExecStart=/opt/afrimove/sauvegardes/verifier.sh
TimeoutStartSec=10min
