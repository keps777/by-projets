# AM-172 · Expédition du journal (WAL) vers les deux fournisseurs (voir afrimove-journal.timer).
[Unit]
Description=AfriMove · expédition du journal PostgreSQL (WAL) chiffré vers les deux fournisseurs
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Environment=SAUVEGARDES_ENV=/etc/afrimove/sauvegardes.env
Environment=RCLONE_CONFIG=/etc/afrimove/rclone.conf
ExecStart=/opt/afrimove/sauvegardes/expedier-journal.sh
SuccessExitStatus=2
TimeoutStartSec=10min
