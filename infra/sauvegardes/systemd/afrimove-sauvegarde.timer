# AM-172 · Chaque nuit à 2 h, heure de Douala (Africa/Douala, UTC+1 toute l'année).
[Unit]
Description=AfriMove · sauvegarde complète chaque nuit à 2 h

[Timer]
OnCalendar=*-*-* 02:00:00 Africa/Douala
# Si l'hôte était éteint à 2 h, la sauvegarde part au démarrage.
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
