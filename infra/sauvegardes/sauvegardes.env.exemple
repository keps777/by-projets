# AM-172 · Configuration des sauvegardes. Copier en « sauvegardes.env » à côté des scripts sur l'hôte
# de production (chmod 600), ou pointer SAUVEGARDES_ENV vers un autre chemin. Ce fichier ne contient
# AUCUN secret de base de données ni clé privée : les identifiants des fournisseurs sont dans
# rclone.conf (chmod 600), et la clé privée age n'est jamais sur le serveur (voir README).

# Deux fournisseurs distincts, dans deux régions : « remote:bucket/dossier » au sens de rclone.
FOURNISSEUR_A=sauv-a:afrimove-sauvegardes/prod
FOURNISSEUR_B=sauv-b:afrimove-sauvegardes/prod

# Clés PUBLIQUES age (age1…) qui peuvent relire les sauvegardes : au moins deux, tenues par deux
# personnes différentes. Séparées par des espaces.
AGE_DESTINATAIRES="age1…cle-publique-de-luther age1…cle-publique-de-secours"

# Comment joindre PostgreSQL. Vide : parler directement à un serveur (variables PG* de l'environnement).
PG_COMMANDE="docker compose --env-file /home/deploy/afrimove/.env -f /home/deploy/afrimove/compose.yaml exec -T db"
PG_UTILISATEUR=afrimove
PG_BASE=afrimove

DOSSIER_TRAVAIL=/var/lib/afrimove/sauvegardes
# Dossier d'attente du journal : monté dans le conteneur postgres sur /wal-spool.
SPOOL_WAL=/var/lib/afrimove/sauvegardes/wal

# Rétention (jours) et garde-fous.
RETENTION_COMPLET_JOURS=30
RETENTION_PHYSIQUE_JOURS=7
RETENTION_JOURNAL_JOURS=7
GARDER_AU_MOINS=3

# Sonde de fraîcheur.
FRAICHEUR_COMPLET_HEURES=26
VERIFIER_JOURNAL=1
FRAICHEUR_JOURNAL_MINUTES=30

# Webhook d'alerte (Slack, Mattermost… accepte un POST JSON {"text": "…"}). Vide : journal seulement.
ALERTE_URL=

# Objectif de restauration (secondes) et tables qui doivent être lisibles après restauration.
OBJECTIF_RESTAURATION_SECONDES=7200
VERIF_TABLES=personne,billet,journal_audit
