#!/usr/bin/env bash
# Faux age pour les tests (le vrai est essayé à part quand il est installé).
# Chiffrer : -r CLE… -o SORTIE [ENTREE]  -> « AGE-FAUX <clés> » puis le contenu en base64 (donc plus lisible).
# Déchiffrer : -d -i IDENTITE -o SORTIE ENTREE  -> échoue si l'identité (ligne « CLE-FAUSSE age1… »)
# n'est pas l'un des destinataires.
set -euo pipefail
mode=chiffrer
destinataires=()
sortie="" identite="" entree=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d) mode=dechiffrer; shift ;;
    -r) destinataires+=("$2"); shift 2 ;;
    -o) sortie="$2"; shift 2 ;;
    -i) identite="$2"; shift 2 ;;
    *) entree="$1"; shift ;;
  esac
done

ecrire() { if [ -n "$sortie" ]; then cat >"$sortie"; else cat; fi; }

if [ "$mode" = chiffrer ]; then
  [ "${#destinataires[@]}" -gt 0 ] || { echo "age (faux) : aucun destinataire" >&2; exit 1; }
  {
    printf 'AGE-FAUX %s\n' "${destinataires[*]}"
    if [ -n "$entree" ]; then base64 -w0 "$entree"; else base64 -w0; fi
  } | ecrire
else
  [ -f "$identite" ] || { echo "age (faux) : identité introuvable" >&2; exit 1; }
  entete="$(head -n1 "$entree")"
  cle="$(sed -n 's/^CLE-FAUSSE //p' "$identite" | head -n1)"
  case " ${entete#AGE-FAUX } " in
    *" $cle "*) ;;
    *) echo "age (faux) : aucune identité ne correspond" >&2; exit 1 ;;
  esac
  tail -n +2 "$entree" | base64 -d | ecrire
fi
