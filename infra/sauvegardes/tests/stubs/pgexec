#!/usr/bin/env bash
# Faux « docker compose exec -T db » pour les tests : reçoit la commande à exécuter dans la base
# (pg_dump, pg_restore, psql, createdb, dropdb, sh, tar, rm) et simule PostgreSQL.
# Réglages par l'environnement : PGFAUX_DUMP_PANNE, PGFAUX_DUMP_VIDE, PGFAUX_DUMP_ILLISIBLE,
# PGFAUX_RESTORE_PANNE, PGFAUX_EXISTE (1 = la base cible existe), PGFAUX_TABLES_AVANT (tables dans la
# base cible avant restauration), PGFAUX_TABLES_APRES, PGFAUX_TABLE_ILLISIBLE (nom), PGFAUX_CONTENU.
set -euo pipefail
journal="${JOURNAL_STUBS:-/dev/null}"
etat="${ETAT_PGFAUX:?ETAT_PGFAUX manque}"
mkdir -p "$etat"
printf 'pg %s\n' "$*" >>"$journal"

commande="${1:?}"
shift
case "$commande" in
  pg_dump)
    [ "${PGFAUX_DUMP_PANNE:-}" != 1 ] || { echo "pg_dump (faux) : connexion refusée" >&2; exit 1; }
    [ "${PGFAUX_DUMP_VIDE:-}" != 1 ] || exit 0
    if [ "${PGFAUX_DUMP_ILLISIBLE:-}" = 1 ]; then printf 'PAS-UNE-ARCHIVE'; else printf 'PGDMP-FAUX|%s|données secrètes de la base' "${PGFAUX_CONTENU:-v1}"; fi
    ;;
  pg_restore)
    contenu="$(cat)"
    case "$contenu" in PGDMP-FAUX*) ;; *) echo "pg_restore (faux) : archive illisible" >&2; exit 1 ;; esac
    if [[ " $* " == *" --list "* ]]; then exit 0; fi
    [ "${PGFAUX_RESTORE_PANNE:-}" != 1 ] || { echo "pg_restore (faux) : erreur SQL" >&2; exit 1; }
    printf '%s' "$contenu" >"$etat/restaure.dump"
    printf 'restauré\n' >>"$journal"
    ;;
  psql)
    requete=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "-c" ]; then requete="$2"; fi
      shift
    done
    case "$requete" in
      *pg_database*) [ "${PGFAUX_EXISTE:-}" = 1 ] && echo 1 || true ;;
      *information_schema.tables*)
        if [ -f "$etat/restaure.dump" ]; then echo "${PGFAUX_TABLES_APRES:-12}"; else echo "${PGFAUX_TABLES_AVANT:-0}"; fi
        ;;
      *"from \""*)
        table="${requete#*from \"}"
        table="${table%%\"*}"
        [ "$table" != "${PGFAUX_TABLE_ILLISIBLE:-}" ] || { echo "ERREUR: relation \"$table\" n'existe pas" >&2; exit 1; }
        echo 42
        ;;
      *) echo "psql (faux) : requête non gérée : $requete" >&2; exit 64 ;;
    esac
    ;;
  createdb) echo "créée" >"$etat/base-creee" ;;
  dropdb) echo "supprimée" >"$etat/base-supprimee"; rm -f "$etat/restaure.dump" ;;
  sh) ;;
  tar) printf 'TAR-PHYSIQUE-FAUX' ;;
  rm) ;;
  *) echo "pgexec (faux) : commande non gérée : $commande" >&2; exit 64 ;;
esac
